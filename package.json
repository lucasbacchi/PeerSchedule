{
    "name": "peerschedule",
    "version": "0.0.1",
    "description": "A peer to peer scheduling application for Wentworth Institute of Technology students.",
    "scripts": {
        "build": "react-router build",
        "dev": "react-router dev --host 0.0.0.0",
        "typecheck": "react-router typegen && tsc",
        "lint": "eslint src react-router.config.ts vite.config.ts eslint.config.js",
        "test:rules": "npx firebase-tools@14.22.0 emulators:exec --only firestore \"node --test tests/firestore.rules.test.mjs\"",
        "format": "prettier --write .",
        "check": "prettier --check ."
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "module",
    "dependencies": {
        "@react-router/node": "^8.1.0",
        "@react-router/serve": "^8.1.0",
        "@tailwindcss/vite": "^4.3.2",
        "firebase": "^12.15.0",
        "isbot": "^5.1.44",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-router": "^8.1.0",
        "tailwindcss": "^4.3.2"
    },
    "devDependencies": {
        "@eslint/js": "^9.0.1",
        "@firebase/rules-unit-testing": "^5.0.0",
        "@react-router/dev": "^8.1.0",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@types/react-router-dom": "^5.3.3",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsx-a11y": "^6.4.1",
        "eslint-plugin-react": "^7.22.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "globals": "^17.7.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.62.1",
        "vite": "^8.1.3"
    },
    "allowScripts": {
        "esbuild@0.28.1": true,
        "@firebase/util@1.15.1": true,
        "protobufjs@7.6.4": true
    },
    "engines": {
        "node": ">=22.22.0"
    }
}
