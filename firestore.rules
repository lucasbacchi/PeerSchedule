rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function calendar(calendarId) {
      return get(/databases/$(database)/documents/calendars/$(calendarId)).data;
    }

    function calendarMember(calendarId) {
      return signedIn() && request.auth.uid in calendar(calendarId).memberIds;
    }

    function calendarOwner(calendarId) {
      return signedIn() && calendar(calendarId).ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && (
        request.auth.uid == userId ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friendIds']) &&
          request.auth.uid in request.resource.data.friendIds &&
          request.resource.data.friendIds.size() == resource.data.friendIds.size() + 1
        )
      );
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /calendars/{calendarId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /events/{eventId} {
      allow read: if calendarMember(resource.data.calendarId);
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && calendarMember(request.resource.data.calendarId);
      allow update: if signedIn()
        && request.resource.data.calendarId == resource.data.calendarId
        && (resource.data.ownerId == request.auth.uid || calendarOwner(resource.data.calendarId));
      allow delete: if signedIn()
        && (resource.data.ownerId == request.auth.uid || calendarOwner(resource.data.calendarId));
    }
  }
}
